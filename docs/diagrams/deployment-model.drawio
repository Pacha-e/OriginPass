        <mxCell id="dbnote" value="Five CHECK constraints hold the business rules in the database as well as in the application, so a rule survives a view that forgets it. Two UNIQUE constraints keep each chain of signed records linear, so no record can be the predecessor of two others. The data model draws all seven." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="db">
          <mxGeometry x="16" y="252" width="360" height="70" as="geometry" />
        </mxCell>

