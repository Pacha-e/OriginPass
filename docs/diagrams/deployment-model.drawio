        <!-- ================= connections ================= -->
        <mxCell id="conn1" value="&amp;laquo;HTTPS&amp;raquo;&amp;nbsp; TLS 1.3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=3;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="phone" target="appserver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn2" value="&amp;laquo;HTTPS&amp;raquo;&amp;nbsp; TLS 1.3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=3;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="1" source="pc" target="appserver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn3" value="&amp;laquo;TCP/IP&amp;raquo;&amp;nbsp; port 5432, psycopg 3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=3;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.28;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="appserver" target="dbserver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn4" value="&amp;laquo;HTTPS&amp;raquo;&amp;nbsp; deploy on push to main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endSize=12;dashed=1;html=1;strokeWidth=3;fontSize=13;labelBackgroundColor=#ffffff;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=1;entryY=0.88;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="github" target="appserver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= notes ================= -->
        <mxCell id="state_note" value="&lt;b&gt;Where the project stands today&lt;/b&gt;&lt;br&gt;&lt;br&gt;The application runs locally: &lt;i&gt;docker compose up -d&lt;/i&gt; provides the PostgreSQL 17 node, and &lt;i&gt;manage.py runserver&lt;/i&gt; the application server. The two are already separate processes speaking the protocol drawn above, so moving to a hosted server changes the address and not the design. Compose also starts a pgAdmin container for looking at the database; it is a tool for reading the system, not a part of it, so it is not drawn as a node.&lt;br&gt;&lt;br&gt;Deployment is the subject of Sprint 4, which is when the course covers it, and a WSGI server arrives with it.&lt;br&gt;&lt;br&gt;Every version named here is the version installed, read from &lt;i&gt;pip list&lt;/i&gt; and from the image tags in docker-compose.yml. It is deliberately not read from requirements.txt, which states the lowest version accepted rather than the one in use." style="shape=note;whiteSpace=wrap;html=1;size=20;align=left;verticalAlign=top;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="880" width="520" height="210" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Colour of the components&lt;/b&gt;&lt;br&gt;&lt;br&gt;blue&amp;nbsp; —&amp;nbsp; delivered in Sprint 1&lt;br&gt;green&amp;nbsp; —&amp;nbsp; being built in Sprint 2&lt;br&gt;purple&amp;nbsp; —&amp;nbsp; model exists, views in Sprint 4" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=none;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="890" width="440" height="120" as="geometry" />
        </mxCell>

