# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Virtual environments
.venv/
venv/
env/

# Django
*.log
*.sqlite3
*.sqlite3-journal
/media/
/staticfiles/

# Environment
.env
.env.local

# Testing, coverage and linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Compiled translations. Built from the tracked .po files with
# `python manage.py compilemessages`, so the binary is not committed.
*.mo

# Editors
.vscode/
.idea/
*.swp

# Course material kept locally for reference, not part of the project
course-material/

# Video production output. The scripts that build it are tracked; the audio,
# the slides and the rendered file are not, because they are large binaries
# that can be rebuilt with `python tools/video/build.py`.
tools/video/build/
*TEMP_MPY_*

# The narration recordings themselves. Audio files do not belong in a code
# repository; the finished video is published elsewhere.
tools/video/voice/*
!tools/video/voice/.gitkeep

# Browser automation session dumps
.playwright-mcp/

# Notes written for the live presentation, not part of the project
docs/diagrams/presentation-notes.md
docs/diagrams/cheat-sheet.md

# Operating system
.DS_Store
Thumbs.db

# Graphify build output. The report and the graph are written to an archive
# outside this repository, but the extractor leaves a cache behind here.
graphify-out/
