<mxfile host="app.diagrams.net" agent="OriginPass" version="24.7.17">
  <diagram name="Sprint 2 mockups" id="originpass-sprint-2-mockups">
    <mxGraphModel dx="1960" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="OriginPass — Sprint 2 mockups" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="24" width="700" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The five views the Sprint 2 requirements are reflected in, drawn in six frames: the last is the public verdict again at the 360 pixel width UR01 names, which a desktop frame cannot show. Each frame names its requirements, its content groups and the one interaction it offers." style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="58" width="1200" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Green marks what Sprint 2 delivered, matching the other three diagrams. Grey is chrome shared with Sprint 1." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="82" width="1200" height="20" as="geometry" />
        </mxCell>

        <!-- ================= 1. Register a product ================= -->
        <mxCell id="f1" value="1 · Register a product — FR19, UR10" style="swimlane;html=1;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;collapsible=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="130" width="560" height="500" as="geometry" />
        </mxCell>
        <mxCell id="f1nav" value="OriginPass&#10;&#10;Verificar un producto · Mi solicitud · Mis productos" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="f1">
          <mxGeometry x="20" y="46" width="520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="f1head" value="&lt;b&gt;Registrar un producto&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #666666;&quot;&gt;Un pasaporte cubre una unidad física, no una línea de productos.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="f1">
          <mxGeometry x="20" y="92" width="520" height="52" as="geometry" />
        </mxCell>
        <mxCell id="f1n1" value="Nombre del producto" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;fontColor=#999999;" vertex="1" parent="f1">
          <mxGeometry x="20" y="156" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f1n2" value="Descripción" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;fontColor=#999999;verticalAlign=top;spacingTop=6;" vertex="1" parent="f1">
          <mxGeometry x="20" y="192" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f1n3" value="Categoría" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;fontColor=#999999;" vertex="1" parent="f1">
          <mxGeometry x="20" y="258" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f1n4" value="Lugar de fabricación" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;fontColor=#999999;" vertex="1" parent="f1">
          <mxGeometry x="290" y="258" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f1n5" value="Fotografía — opcional" style="dashed=1;rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;fontColor=#999999;" vertex="1" parent="f1">
          <mxGeometry x="20" y="294" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f1btn" value="Emitir el pasaporte" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="f1">
          <mxGeometry x="20" y="336" width="150" height="32" as="geometry" />
        </mxCell>
        <mxCell id="f1note" value="&lt;b&gt;What&lt;/b&gt; Five fields and one action.&lt;br&gt;&lt;b&gt;Where&lt;/b&gt; One column, one card, no sidebar.&lt;br&gt;&lt;b&gt;How&lt;/b&gt; Submit. A refusal is rendered beside the field that caused it (UR08).&lt;br&gt;&lt;br&gt;UR10 caps the required fields at five: four here plus the photograph, which is optional. The passport code and the product type are never fields — one is generated (FR21), the other follows from the company (FR23)." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="f1">
          <mxGeometry x="20" y="380" width="520" height="110" as="geometry" />
        </mxCell>

        <!-- ================= 2. Registration refused ================= -->
        <mxCell id="f2" value="2 · Registration refused — FR20" style="swimlane;html=1;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;collapsible=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="130" width="560" height="500" as="geometry" />
        </mxCell>
        <mxCell id="f2nav" value="OriginPass&#10;&#10;Verificar un producto · Mi solicitud · Mis productos" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="f2">
          <mxGeometry x="20" y="46" width="520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="f2head" value="&lt;b&gt;Esta empresa no puede emitir un pasaporte&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="f2">
          <mxGeometry x="20" y="92" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f2notice" value="Tu solicitud todavía está en revisión. Podrás emitir pasaportes cuando quede aprobada." style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="f2">
          <mxGeometry x="20" y="144" width="520" height="48" as="geometry" />
        </mxCell>
        <mxCell id="f2dl" value="Empresa&#9;Artesanías La Bonga SAS&#10;Estado&#9;&#9;[ Pendiente ]&#10;Motivo registrado&#9;—" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="f2">
          <mxGeometry x="20" y="204" width="520" height="76" as="geometry" />
        </mxCell>
        <mxCell id="f2b1" value="Ver mi solicitud" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="f2">
          <mxGeometry x="20" y="292" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f2b2" value="Volver a mis productos" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="f2">
          <mxGeometry x="162" y="292" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f2note" value="&lt;b&gt;What&lt;/b&gt; The cause, the company's status, the way out.&lt;br&gt;&lt;b&gt;Where&lt;/b&gt; One column, one card, the cause above the detail.&lt;br&gt;&lt;b&gt;How&lt;/b&gt; Read-only. Two links out, no dead end.&lt;br&gt;&lt;br&gt;Served with 403, not by hiding the page. FR20 asks the refusal to state its cause, and the wording differs per status: pending, rejected and suspended each get their own sentence." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="f2">
          <mxGeometry x="20" y="336" width="520" height="150" as="geometry" />
        </mxCell>

        <!-- ================= 3. My products ================= -->
        <mxCell id="f3" value="3 · A company's own passports — FR24, FR25" style="swimlane;html=1;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;collapsible=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1300" y="130" width="560" height="500" as="geometry" />
        </mxCell>
        <mxCell id="f3nav" value="OriginPass&#10;&#10;Verificar un producto · Mi solicitud · Mis productos" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="f3">
          <mxGeometry x="20" y="46" width="520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="f3head" value="&lt;b&gt;Productos de Artesanías La Bonga SAS&lt;/b&gt;" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=none;fontSize=12;align=left;spacingLeft=2;verticalAlign=middle;" vertex="1" parent="f3">
          <mxGeometry x="20" y="88" width="520" height="26" as="geometry" />
        </mxCell>
        <mxCell id="f3reg" value="Registrar un producto" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="f3">
          <mxGeometry x="20" y="118" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f3filter" value="[ Todos ]   Activo   Revocado" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="f3">
          <mxGeometry x="20" y="156" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f3search" value="Nombre, categoría o código      [ Buscar ]" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;fontColor=#999999;verticalAlign=middle;" vertex="1" parent="f3">
          <mxGeometry x="290" y="156" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f3th" value="Producto&#9;Categoría&#9;Código&#9;Registrado&#9;Estado" style="rounded=0;html=1;fillColor=#e8e8e8;strokeColor=#b3b3b3;fontSize=10;fontStyle=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="f3">
          <mxGeometry x="20" y="196" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f3r1" value="Sombrero vueltiao&#9;Sombreros&#9;aLEF…DyD&#9;9 sep 2026&#9;[ Activo ]" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="f3">
          <mxGeometry x="20" y="224" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f3r2" value="Canasto de iraca&#9;Cestería&#9;wq-5…0Oi_&#9;9 sep 2026&#9;[ Revocado ]" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="f3">
          <mxGeometry x="20" y="252" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f3note" value="&lt;b&gt;What&lt;/b&gt; A status filter, a search box, and the table of passports.&lt;br&gt;&lt;b&gt;Where&lt;/b&gt; Filter and search sit above the table they act on.&lt;br&gt;&lt;b&gt;How&lt;/b&gt; Both are GET parameters and combine: filtering by Revocado and then searching narrows within the filter rather than replacing it.&lt;br&gt;&lt;br&gt;The list shows only this company's passports. Another company's are not filtered out of the page; they are never queried. FR24 gives it a three second bound, which the suite measures." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="f3">
          <mxGeometry x="20" y="296" width="520" height="180" as="geometry" />
        </mxCell>

        <!-- ================= 4. Passport detail ================= -->
        <mxCell id="f4" value="4 · Passport detail and QR — FR22, FR26" style="swimlane;html=1;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;collapsible=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="670" width="560" height="500" as="geometry" />
        </mxCell>
        <mxCell id="f4head" value="&lt;b&gt;Sombrero vueltiao 21 vueltas&lt;/b&gt;   [ Activo ]" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=none;fontSize=12;align=left;spacingLeft=2;verticalAlign=middle;" vertex="1" parent="f4">
          <mxGeometry x="20" y="46" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f4card" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="f4">
          <mxGeometry x="20" y="80" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="f4dl" value="Código de pasaporte&#9;aLEFqtlOPpuNcYeyO6tAlPrtzDxM_DyD&#10;Tipo&#9;&#9;&#9;Original comercial&#10;Categoría&#9;&#9;Sombreros&#10;Lugar de fabricación&#9;Tuchín, Córdoba&#10;Dirección de verificación&#9;origin.pass/v/aLEF…DyD" style="text;html=1;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="f4">
          <mxGeometry x="32" y="92" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f4qr" value="QR&#10;&#10;(PNG)" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="f4">
          <mxGeometry x="392" y="96" width="120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f4b1" value="Descargar el código QR" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="f4">
          <mxGeometry x="32" y="252" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f4b2" value="Editar" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="f4">
          <mxGeometry x="214" y="252" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f4note" value="&lt;b&gt;What&lt;/b&gt; The code, the QR that encodes it, and the public address it points at.&lt;br&gt;&lt;b&gt;Where&lt;/b&gt; Detail on the left, the image beside it, actions underneath.&lt;br&gt;&lt;b&gt;How&lt;/b&gt; One click downloads the PNG. Edit changes the descriptive fields only.&lt;br&gt;&lt;br&gt;The QR encodes the verification address shown above it, so what is printed and what is served cannot drift apart. FR26 keeps the passport code out of the edit form: it is already printed on something. A revoked passport has no Edit button at all." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="f4">
          <mxGeometry x="20" y="322" width="520" height="160" as="geometry" />
        </mxCell>

        <!-- ================= 5. Public verdict, desktop ================= -->
        <mxCell id="f5" value="5 · Public verdict — FR28, FR29, FR30, FR31" style="swimlane;html=1;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;collapsible=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="670" width="560" height="500" as="geometry" />
        </mxCell>
        <mxCell id="f5nav" value="OriginPass&#10;&#10;Verificar un producto · Iniciar sesión · Crear cuenta" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="f5">
          <mxGeometry x="20" y="46" width="520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="f5v" value="&lt;b&gt;Auténtico&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Este pasaporte corresponde a un producto activo registrado por una empresa verificada.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="f5">
          <mxGeometry x="20" y="92" width="520" height="76" as="geometry" />
        </mxCell>
        <mxCell id="f5card" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="f5">
          <mxGeometry x="20" y="180" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="f5dl" value="Sombrero vueltiao 21 vueltas · Sombreros&#10;&#10;Hecho en&#9;&#9;Tuchín, Córdoba&#10;Registrado por&#9;Artesanías La Bonga SAS&#10;Verificado por&#9;Cámara de Comercio&#10;Pasaporte emitido&#9;9 septiembre 2026" style="text;html=1;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="f5">
          <mxGeometry x="32" y="192" width="400" height="126" as="geometry" />
        </mxCell>
        <mxCell id="f5alt" value="Revocado — fondo rojo, fecha del retiro.&#10;No encontrado — fondo gris, mismo texto para todo código sin coincidencia." style="dashed=1;rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="f5">
          <mxGeometry x="20" y="340" width="520" height="46" as="geometry" />
        </mxCell>
        <mxCell id="f5note" value="&lt;b&gt;What&lt;/b&gt; The verdict, then the product, then what the verdict means.&lt;br&gt;&lt;b&gt;Where&lt;/b&gt; The verdict is first and largest: it is the answer to the question that was asked.&lt;br&gt;&lt;b&gt;How&lt;/b&gt; None. The page is the answer to the scan, not a form.&lt;br&gt;&lt;br&gt;No session, no script, one stylesheet. FR31 gives every unmatched code the same page, because telling one kind of miss from another would leak which codes are live." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="f5">
          <mxGeometry x="20" y="396" width="520" height="90" as="geometry" />
        </mxCell>

        <!-- ================= 6. Public verdict at 360px ================= -->
        <mxCell id="f6" value="6 · The same verdict on a 360 px screen — UR01, UR02, UR03" style="swimlane;html=1;startSize=34;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;collapsible=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1300" y="670" width="560" height="500" as="geometry" />
        </mxCell>
        <mxCell id="f6phone" value="360 px" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=9;fontColor=#999999;verticalAlign=top;align=center;spacingTop=2;" vertex="1" parent="f6">
          <mxGeometry x="20" y="46" width="240" height="420" as="geometry" />
        </mxCell>
        <mxCell id="f6nav" value="OriginPass          ☰" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=9;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="f6phone">
          <mxGeometry x="10" y="20" width="220" height="26" as="geometry" />
        </mxCell>
        <mxCell id="f6v" value="&lt;b&gt;Auténtico&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;Producto activo de una empresa verificada.&lt;/font&gt;" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="f6phone">
          <mxGeometry x="10" y="54" width="220" height="66" as="geometry" />
        </mxCell>
        <mxCell id="f6card" value="Sombrero vueltiao&#10;21 vueltas&#10;&#10;Hecho en&#10;Tuchín, Córdoba&#10;&#10;Registrado por&#10;Artesanías La Bonga SAS&#10;&#10;Verificado por&#10;Cámara de Comercio" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="f6phone">
          <mxGeometry x="10" y="128" width="220" height="200" as="geometry" />
        </mxCell>
        <mxCell id="f6foot" value="No hace falta cuenta para verificar un producto." style="text;html=1;fontSize=8;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="f6phone">
          <mxGeometry x="10" y="336" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f6note" value="&lt;b&gt;What&lt;/b&gt; The same three groups, stacked instead of placed side by side.&lt;br&gt;&lt;b&gt;Where&lt;/b&gt; One column throughout. No rule fixes a width in pixels wider than the screen, so the page never scrolls sideways.&lt;br&gt;&lt;b&gt;How&lt;/b&gt; UR02: the scan is the first interaction and the verdict is the answer, so there is no second one.&lt;br&gt;&lt;br&gt;UR03: the verdict is a word before it is a colour. Someone who does not distinguish green from red reads the same answer as everyone else, which is why &quot;Auténtico&quot; is written and not only shown.&lt;br&gt;&lt;br&gt;This is the frame that matters most: a buyer standing at a stall, on the narrowest phone still in common use, with one chance to understand the answer." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="f6">
          <mxGeometry x="280" y="46" width="260" height="430" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="ST0251 Proyecto Integrador 1, 2026-2 · OriginPass · Emmanuel Hernández Melo · Deliverable 2, section 2" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="1210" width="900" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
