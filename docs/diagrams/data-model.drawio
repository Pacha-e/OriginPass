        <mxCell id="notes" value="&lt;b&gt;Enumerations&lt;/b&gt;&lt;br&gt;&lt;br&gt;accounts_user.role&amp;nbsp; —&amp;nbsp; ADMIN | COMPANY | HOLDER&lt;br&gt;companies_company.company_type&amp;nbsp; —&amp;nbsp; COMMERCIAL | ARTISAN&lt;br&gt;companies_company.verification_track&amp;nbsp; —&amp;nbsp; CHAMBER_OF_COMMERCE | OFFICIAL_REGISTRY | ARTISAN_REVIEW&lt;br&gt;companies_company.status&amp;nbsp; —&amp;nbsp; PENDING | APPROVED | REJECTED | SUSPENDED&lt;br&gt;products_product.product_type&amp;nbsp; —&amp;nbsp; COMMERCIAL_ORIGINAL | ARTISAN&lt;br&gt;products_product.status&amp;nbsp; —&amp;nbsp; ACTIVE | REVOKED&lt;br&gt;products_custodytransfer.state&amp;nbsp; —&amp;nbsp; INITIATED | ACCEPTED | DECLINED&lt;br&gt;verification_scanevent.verdict&amp;nbsp; —&amp;nbsp; GENUINE | REVOKED | NOT_FOUND&lt;br&gt;verification_scanevent.device_category&amp;nbsp; —&amp;nbsp; MOBILE | TABLET | DESKTOP | UNKNOWN" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="890" width="620" height="220" as="geometry" />
        </mxCell>

        <mxCell id="constraints" value="&lt;b&gt;Rules the database holds itself — a rule here survives a view that forgets it&lt;br&gt;&lt;br&gt;&lt;b&gt;Check constraints&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;company_track_matches_type&lt;/b&gt;&amp;nbsp; a commercial company uses CHAMBER_OF_COMMERCE or OFFICIAL_REGISTRY; an artisan company uses ARTISAN_REVIEW&lt;br&gt;&lt;br&gt;&lt;b&gt;commercial_company_has_registry_code&lt;/b&gt;&amp;nbsp; registry_code is filled for COMMERCIAL and empty for ARTISAN&amp;nbsp; (FR08, FR09)&lt;br&gt;&lt;br&gt;&lt;b&gt;negative_decision_states_a_reason&lt;/b&gt;&amp;nbsp; status_reason is filled when status is REJECTED or SUSPENDED&amp;nbsp; (DBR12)&lt;br&gt;&lt;br&gt;&lt;b&gt;revocation_states_a_reason&lt;/b&gt;&amp;nbsp; revocation_reason is filled when status is REVOKED&amp;nbsp; (DBR12)&lt;br&gt;&lt;br&gt;&lt;b&gt;custody_transfer_changes_holder&lt;/b&gt;&amp;nbsp; from_holder_id is not to_holder_id&lt;br&gt;&lt;br&gt;&lt;b&gt;Unique constraints&lt;/b&gt; &amp;#8212; each chain of signed records stays linear&lt;br&gt;&lt;br&gt;&lt;b&gt;audit_entry_links_to_one_predecessor&lt;/b&gt;&amp;nbsp; no audit entry is the predecessor of two others&lt;br&gt;&lt;br&gt;&lt;b&gt;custody_transfer_links_to_one_predecessor&lt;/b&gt;&amp;nbsp; within one product, no handover is the predecessor of two others" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="890" width="640" height="220" as="geometry" />
        </mxCell>

