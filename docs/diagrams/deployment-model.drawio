<mxfile host="app.diagrams.net" agent="OriginPass" version="24.7.17"><diagram name="Deployment model" id="originpass-deployment-model"><mxGraphModel dx="1960" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="OriginPass — Deployment model" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="24" width="900" height="32" as="geometry" /></mxCell><mxCell id="subtitle" value="As deployed on AWS EC2 for Deliverable 4: the devices, the software installed on each one with its version, and the protocol between them" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="58" width="1300" height="22" as="geometry" /></mxCell><mxCell id="phone" value="&lt;i&gt;«device»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Smartphone / tablet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Android · iOS&lt;/font&gt;" style="swimlane;html=1;startSize=64;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="360" height="338" as="geometry" /></mxCell><mxCell id="phone_browser" value="&lt;i&gt;«execution environment»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Mobile web browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;any current Chrome or Safari&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="phone"><mxGeometry x="24" y="76" width="312" height="64" as="geometry" /></mxCell><mxCell id="phone_qr" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Camera / QR reader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;opens the verification address&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;dashed=1;" vertex="1" parent="phone"><mxGeometry x="24" y="152" width="312" height="64" as="geometry" /></mxCell><mxCell id="phone_scanner" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br&gt;&lt;b&gt;passport-scanner.js + jsQR 1.4.0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;on the claim page: reads the passport QR with the&lt;br&gt;camera (HTTPS only) or from a photo (FR60)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeeed;strokeColor=#138a84;fontSize=12;dashed=1;" vertex="1" parent="phone"><mxGeometry x="24" y="228" width="312" height="92" as="geometry" /></mxCell><mxCell id="pc" value="&lt;i&gt;«device»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Personal computer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Windows · macOS · Linux&lt;/font&gt;" style="swimlane;html=1;startSize=64;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="360" height="230" as="geometry" /></mxCell><mxCell id="pc_browser" value="&lt;i&gt;«execution environment»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Desktop web browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;any current Chrome, Firefox, Edge or Safari&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="pc"><mxGeometry x="24" y="76" width="312" height="64" as="geometry" /></mxCell><mxCell id="pc_ssh" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br&gt;&lt;b&gt;OpenSSH client + key pair&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;administration: deploy/aws scripts&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;dashed=1;" vertex="1" parent="pc"><mxGeometry x="24" y="152" width="312" height="62" as="geometry" /></mxCell><mxCell id="client_note" value="A company owner and the administrator work from either device. A buyer verifies from the phone, with no account and nothing to install." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="100" y="760" width="360" height="60" as="geometry" /></mxCell><mxCell id="mail" value="&lt;i&gt;«device»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Mail service (external)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;not connected on the instance: Django's console&lt;br&gt;backend writes the FR06, FR53, FR54 and FR55&lt;br&gt;emails to the service log&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;align=center;verticalAlign=middle;fontSize=13;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="100" y="840" width="360" height="150" as="geometry" /></mxCell><mxCell id="ec2" value="&lt;i&gt;«device»&lt;/i&gt;&lt;br&gt;&lt;b&gt;AWS EC2 instance  t3.small&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Ubuntu Server 26.04.1 LTS · AWS Academy Learner Lab&lt;/font&gt;" style="swimlane;html=1;startSize=64;align=center;verticalAlign=middle;fillColor=#cdeeed;strokeColor=#138a84;fontSize=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="900" height="900" as="geometry" /></mxCell><mxCell id="nginx" value="&lt;i&gt;«execution environment»&lt;/i&gt;&lt;br&gt;&lt;b&gt;nginx 1.28.3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;reverse proxy on ports 80 and 443 · TLS certificate from Let's Encrypt (certbot) · HTTP redirects to HTTPS · serves /media/ from disk&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#138a84;fontSize=12;" vertex="1" parent="ec2"><mxGeometry x="24" y="76" width="852" height="80" as="geometry" /></mxCell><mxCell id="python" value="&lt;i&gt;«execution environment»&lt;/i&gt;&amp;nbsp; &lt;b&gt;Python 3.14&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Ubuntu 26.04 package · virtualenv /opt/originpass/venv&lt;/font&gt;" style="swimlane;html=1;startSize=52;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;collapsible=0;" vertex="1" parent="ec2"><mxGeometry x="24" y="186" width="520" height="616" as="geometry" /></mxCell><mxCell id="gunicorn" value="&lt;i&gt;«execution environment»&lt;/i&gt;&lt;br&gt;&lt;b&gt;gunicorn 23&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;systemd service originpass · 2 workers&lt;br&gt;«HTTP» from nginx on 127.0.0.1:8000&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeeed;strokeColor=#138a84;fontSize=12;" vertex="1" parent="python"><mxGeometry x="16" y="62" width="488" height="56" as="geometry" /></mxCell><mxCell id="django" value="&lt;i&gt;«execution environment»&lt;/i&gt;&amp;nbsp; &lt;b&gt;Django 5.2&lt;/b&gt;&amp;nbsp; (MVT)" style="swimlane;html=1;startSize=42;align=center;verticalAlign=middle;fillColor=#eaf3fc;strokeColor=#6c8ebf;fontSize=13;collapsible=0;" vertex="1" parent="python"><mxGeometry x="16" y="122" width="488" height="330" as="geometry" /></mxCell><mxCell id="c_accounts" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;accounts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="django"><mxGeometry x="14" y="52" width="225" height="40" as="geometry" /></mxCell><mxCell id="c_companies" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;companies" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="django"><mxGeometry x="249" y="52" width="225" height="40" as="geometry" /></mxCell><mxCell id="c_products" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;products" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="django"><mxGeometry x="14" y="100" width="225" height="40" as="geometry" /></mxCell><mxCell id="c_verification" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;verification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="django"><mxGeometry x="249" y="100" width="225" height="40" as="geometry" /></mxCell><mxCell id="c_audit" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;audit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="django"><mxGeometry x="14" y="148" width="225" height="40" as="geometry" /></mxCell><mxCell id="c_config" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;config" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="django"><mxGeometry x="249" y="148" width="225" height="40" as="geometry" /></mxCell><mxCell id="c_pages" value="&lt;i&gt;«component»&lt;/i&gt;&lt;br&gt;pages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="django"><mxGeometry x="14" y="196" width="460" height="40" as="geometry" /></mxCell><mxCell id="libs" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br&gt;&lt;b&gt;libraries from requirements.txt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;psycopg 3 (binary) · Pillow · qrcode 8 · WhiteNoise 6 (serves /static/)&lt;br&gt;dj-database-url · python-dotenv&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;dashed=1;" vertex="1" parent="django"><mxGeometry x="14" y="248" width="460" height="70" as="geometry" /></mxCell><mxCell id="staticfiles" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br&gt;&lt;b&gt;staticfiles/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;CSS, scanner JS, jsQR, favicon · collectstatic&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="python"><mxGeometry x="16" y="464" width="236" height="64" as="geometry" /></mxCell><mxCell id="mediafiles" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br&gt;&lt;b&gt;media/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;product images, logos · served by nginx&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="python"><mxGeometry x="268" y="464" width="236" height="64" as="geometry" /></mxCell><mxCell id="envfile" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br&gt;&lt;b&gt;/etc/originpass.env&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;SECRET_KEY, DATABASE_URL, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS · readable by root only&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="python"><mxGeometry x="16" y="540" width="488" height="60" as="geometry" /></mxCell><mxCell id="postgres" value="&lt;i&gt;«execution environment»&lt;/i&gt;&lt;br&gt;&lt;b&gt;PostgreSQL 18&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Ubuntu 26.04 package&lt;br&gt;«TCP/IP» 127.0.0.1:5432 from Django (psycopg 3)&lt;/font&gt;" style="swimlane;html=1;startSize=64;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;collapsible=0;" vertex="1" parent="ec2"><mxGeometry x="568" y="186" width="308" height="616" as="geometry" /></mxCell><mxCell id="db" value="&lt;i&gt;«artifact»&lt;/i&gt;&amp;nbsp; &lt;b&gt;originpass&lt;/b&gt;&amp;nbsp; (schema)" style="swimlane;html=1;startSize=42;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;collapsible=0;" vertex="1" parent="postgres"><mxGeometry x="12" y="76" width="284" height="330" as="geometry" /></mxCell><mxCell id="t1" value="accounts_user" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="db"><mxGeometry x="12" y="52" width="260" height="28" as="geometry" /></mxCell><mxCell id="t2" value="companies_company" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="db"><mxGeometry x="12" y="86" width="260" height="28" as="geometry" /></mxCell><mxCell id="t3" value="products_product — unique passport_code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="db"><mxGeometry x="12" y="120" width="260" height="28" as="geometry" /></mxCell><mxCell id="t4" value="products_custodytransfer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="db"><mxGeometry x="12" y="154" width="260" height="28" as="geometry" /></mxCell><mxCell id="t5" value="verification_scanevent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="db"><mxGeometry x="12" y="188" width="260" height="28" as="geometry" /></mxCell><mxCell id="t6" value="audit_auditentry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="db"><mxGeometry x="12" y="222" width="260" height="28" as="geometry" /></mxCell><mxCell id="t7" value="accounts_loginattempt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="db"><mxGeometry x="12" y="256" width="260" height="28" as="geometry" /></mxCell><mxCell id="t8" value="products_alert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="db"><mxGeometry x="12" y="290" width="260" height="28" as="geometry" /></mxCell><mxCell id="dbnote" value="CHECK and UNIQUE constraints hold the business rules in the database as well as in the application, so a rule survives a view that forgets it. The data model lists them." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="postgres"><mxGeometry x="12" y="418" width="284" height="90" as="geometry" /></mxCell><mxCell id="sg_note" value="&lt;b&gt;Security group:&lt;/b&gt; inbound 22 (SSH) from the administrator's address, 80 (HTTP) and 443 (HTTPS) from anywhere. PostgreSQL and gunicorn listen on 127.0.0.1 only, so neither is reachable from outside the instance." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333333;" vertex="1" parent="ec2"><mxGeometry x="24" y="826" width="852" height="60" as="geometry" /></mxCell><mxCell id="github" value="&lt;i&gt;«device»&lt;/i&gt;&lt;br&gt;&lt;b&gt;GitHub (external service)&lt;/b&gt;" style="swimlane;html=1;startSize=52;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1580" y="150" width="340" height="238" as="geometry" /></mxCell><mxCell id="gh_repo" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Pacha-e/OriginPass&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;source code, wiki and backlog&lt;br&gt;pulled by deploy/aws/actualizar-ec2.sh&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;dashed=1;" vertex="1" parent="github"><mxGeometry x="24" y="66" width="292" height="60" as="geometry" /></mxCell><mxCell id="gh_ci" value="&lt;i&gt;«execution environment»&lt;/i&gt;&lt;br&gt;&lt;b&gt;GitHub Actions runner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;ruff · Django test suite on Python 3.12&lt;br&gt;service container postgres:17-alpine&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="github"><mxGeometry x="24" y="138" width="292" height="80" as="geometry" /></mxCell><mxCell id="letsencrypt" value="&lt;i&gt;«device»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Let's Encrypt (external)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;certificate authority&lt;/font&gt;" style="swimlane;html=1;startSize=64;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1580" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="le_cert" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br&gt;&lt;b&gt;TLS certificate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;for the sslip.io name · renewed by certbot&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cdeeed;strokeColor=#138a84;fontSize=12;dashed=1;" vertex="1" parent="letsencrypt"><mxGeometry x="24" y="76" width="292" height="58" as="geometry" /></mxCell><mxCell id="dns_note" value="&lt;b&gt;Public name&lt;/b&gt;&lt;br&gt;&lt;br&gt;The name a-b-c-d.sslip.io is answered by the public sslip.io DNS with the address a.b.c.d of the instance. The instance holds the Elastic IP 44.206.186.9, so the name 44-206-186-9.sslip.io, the certificate and ALLOWED_HOSTS survive a restart of the instance." style="shape=note;whiteSpace=wrap;html=1;size=20;align=left;verticalAlign=top;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1580" y="600" width="340" height="170" as="geometry" /></mxCell><mxCell id="state_note" value="&lt;b&gt;Where the project stands, 5 November 2026&lt;/b&gt;&lt;br&gt;&lt;br&gt;Deployed on one EC2 instance of the AWS Academy Learner Lab and reached over HTTPS.&lt;br&gt;&lt;br&gt;nginx is read from the Server header of the live site. Python and PostgreSQL are the Ubuntu 26.04 packages, 3.14 and 18 by distribution default. The Python libraries are installed from requirements.txt when the instance is updated, so their patch level follows its ranges.&lt;br&gt;&lt;br&gt;The test suite runs in CI on Python 3.12 and PostgreSQL 17, and locally on PostgreSQL 17 in Docker." style="shape=note;whiteSpace=wrap;html=1;size=20;align=left;verticalAlign=top;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1580" y="800" width="340" height="300" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Colour&lt;/b&gt;&lt;br&gt;&lt;br&gt;red — client devices&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;teal — added in Sprint 4: the EC2 node, nginx, gunicorn, the QR reader in the browser, the certificate&lt;br&gt;blue, green, purple — the Django components, as in the component model&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;orange — the database&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;grey — external services" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=none;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="1060" width="900" height="100" as="geometry" /></mxCell><mxCell id="footer" value="ST0251 Proyecto Integrador 1, 2026-2 · OriginPass · Emmanuel Hernández Melo · Deliverable 4, section 2.1" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="1270" width="900" height="20" as="geometry" /></mxCell><mxCell id="e_phone" value="«HTTPS» port 443&lt;br&gt;HTTP 80 redirects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="phone" target="ec2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_pc" value="«HTTPS» port 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="pc" target="ec2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_ssh" value="«SSH» port 22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;dashed=1;endArrow=none;" edge="1" parent="1" source="pc" target="ec2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_proxy" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;endArrow=open;endSize=12;" edge="1" parent="1" source="nginx" target="gunicorn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="django" target="postgres"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_github" value="«HTTPS»&lt;br&gt;git pull" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.12;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=open;endSize=12;" edge="1" parent="1" source="ec2" target="github"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_le" value="«HTTPS»&lt;br&gt;ACME" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.38;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="ec2" target="letsencrypt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_mail" value="«SMTP» not configured" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.88;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=none;strokeColor=#d79b00;" edge="1" parent="1" source="ec2" target="mail"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>