# Copy this file to .env and fill in the values.

# Connection string for the PostgreSQL database. The application refuses to
# start without it; there is no fallback to another engine.
# The value below matches the db service in docker-compose.yml.
DATABASE_URL=postgres://originpass:originpass@localhost:5432/originpass

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# This key also signs every integrity record. New records are signed with it;
# records written under a previous key still verify while that key is listed in
# SECRET_KEY_FALLBACKS, comma separated. Put the previous value there when you
# rotate, and drop it only once nothing signed under it is left.
SECRET_KEY=replace-me
SECRET_KEY_FALLBACKS=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Transport hardening. Leave these off for local development, which is served
# over plain HTTP, and turn them on in any deployment that sits behind TLS.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
