        <!-- ================= design note ================= -->
        <mxCell id="note_anon" value="&lt;b&gt;verification depends on products, and on nothing else.&lt;/b&gt;&lt;br&gt;&lt;br&gt;It has no dependency on accounts, because a buyer verifies a product without an account (FR28).&lt;br&gt;&lt;br&gt;This is the shortest path in the system by design. It is the one page opened by people the project cannot contact and cannot support, so it depends on the smallest number of components." style="shape=note;whiteSpace=wrap;html=1;size=18;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="560" width="400" height="200" as="geometry" />
